# Copy this file to `.env` and fill in your credentials.
# Then set as Firebase Secret Manager secrets before deploying:
#
#   firebase functions:secrets:set MAIL_USER
#   firebase functions:secrets:set MAIL_PASS
#
# For Gmail you must use an App Password (requires 2FA on the account).
# Generate one at: https://myaccount.google.com/apppasswords
#
# The functions read these values at runtime via process.env.MAIL_USER / MAIL_PASS.

