{
  "name": "rakni-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for Rakni OTP email verification",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "nodemailer": "^6.9.9",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.14",
    "@types/react": "^19.2.17",
    "typescript": "^5.3.3"
  },
  "private": true
}
